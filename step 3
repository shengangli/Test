"""
structuredquery カスタムエントリポイント

Bedrock Knowledge Base を RetrieveAndGenerate で検索・回答生成し、
回答テキストと引用メタデータを 1 件の dict として yield する。

ResponseHandler.make_success_response() は受け取った値をそのまま
custom_entrypoint_response に格納するため、以下の形になる:

  "custom_entrypoint_response": {
      "context_str": "<生成された回答テキスト>",
      "retriever_metadata": [
          {"filename": "...", "url": "...", "page_content": "..."},
          ...
      ]
  }
"""

import asyncio
import logging
from pathlib import PurePosixPath

import boto3

from entrypoint.utilities.customactionbase import CustomEntrypointBase

logger = logging.getLogger(__name__)

NUM_RESULTS = 5
STOP_CODON = "__STOP_CODON__"


class CustomEntrypoint(CustomEntrypointBase):
    """structuredquery 用エントリポイント."""

    def __init__(self, domain_dict=None, logger_obj=None):
        self.domain_dict = domain_dict or {}
        self.logger_obj = logger_obj or logger

    async def execute_custom_entrypoint(
        self,
        app_name=None,
        request=None,
        request_payload=None,
        app_config_dict=None,
        **kwargs,
    ):
        cfg = app_config_dict or {}
        question = self._extract_question(request_payload)

        if not question:
            yield {"context_str": "質問が取得できませんでした。",
                   "retriever_metadata": []}
            yield STOP_CODON
            return

        try:
            # 同期の boto3 呼び出しをイベントループから外す
            answer_text, metadata_list = await asyncio.to_thread(
                self._call_bedrock, question, cfg
            )
        except Exception:
            self.logger_obj.exception("Bedrock RetrieveAndGenerate に失敗しました")
            yield {"context_str": "検索中にエラーが発生しました。",
                   "retriever_metadata": []}
            yield STOP_CODON
            return

        yield {
            "context_str": answer_text,
            "retriever_metadata": metadata_list,
        }
        yield STOP_CODON

    # ------------------------------------------------------------------
    @staticmethod
    def _extract_question(request_payload):
        """リクエストから質問文を取り出す."""
        if not isinstance(request_payload, dict):
            return ""
        return (request_payload.get("prompt") or "").strip()

    @staticmethod
    def _call_bedrock(question, cfg):
        """RetrieveAndGenerate を1回呼び、(回答テキスト, メタデータ) を返す."""
        region = cfg.get("aws_region", "ap-northeast-1")
        kb_id = cfg.get("knowledge_base_id")
        model_arn = cfg.get("generation_model_arn")

        if not kb_id or not model_arn:
            raise ValueError(
                "app_config_dict に knowledge_base_id / "
                "generation_model_arn が設定されていません"
            )

        client = boto3.client("bedrock-agent-runtime", region_name=region)

        resp = client.retrieve_and_generate(
            input={"text": question},
            retrieveAndGenerateConfiguration={
                "type": "KNOWLEDGE_BASE",
                "knowledgeBaseConfiguration": {
                    "knowledgeBaseId": kb_id,
                    "modelArn": model_arn,
                    "retrievalConfiguration": {
                        "vectorSearchConfiguration": {
                            "numberOfResults": cfg.get("num_results", NUM_RESULTS),
                        }
                    },
                },
            },
        )

        answer_text = (resp.get("output") or {}).get("text", "")

        # citations -> スライド仕様の retriever_metadata 形式へ
        metadata_list = []
        seen = set()
        for citation in resp.get("citations", []):
            for ref in citation.get("retrievedReferences", []):
                url = (ref.get("metadata") or {}).get(
                    "x-amz-bedrock-kb-source-uri", ""
                )
                content = (ref.get("content") or {}).get("text", "")
                key = (url, content)
                if key in seen:
                    continue
                seen.add(key)
                metadata_list.append({
                    "filename": PurePosixPath(url).name if url else "",
                    "url": url,
                    "page_content": content,
                })

        return answer_text, metadata_list
