"""
structuredquery カスタムエントリポイント

Bedrock Knowledge Base を RetrieveAndGenerateStream で検索・回答生成し、
回答テキストを逐次 str で yield したあと、
最後に引用メタデータを 1 件の dict として yield する。

ResponseHandler.make_success_response() は受け取った値をそのまま
custom_entrypoint_response に格納するため:

  str を yield  -> "custom_entrypoint_response": "テキスト断片"   (1UI側で連結)
  dict を yield -> "custom_entrypoint_response": {
                       "context_str": "<回答全文>",
                       "retriever_metadata": [
                           {"filename": ..., "url": ..., "page_content": ...},
                       ]
                   }
"""

import asyncio
import logging
import threading
from pathlib import PurePosixPath

import boto3

from entrypoint.utilities.customactionbase import CustomEntrypointBase

logger = logging.getLogger(__name__)

NUM_RESULTS = 5
STOP_CODON = "__STOP_CODON__"

_SOURCE_URI_KEY = "x-amz-bedrock-kb-source-uri"


class CustomEntrypoint(CustomEntrypointBase):
    """structuredquery 用エントリポイント."""

    def __init__(self, domain_dict=None, logger_obj=None):
        self.domain_dict = domain_dict or {}
        self.logger_obj = logger_obj or logger

    async def execute_custom_entrypoint(
        self,
        app_name=None,
        request=None,
        request_payload=None,
        app_config_dict=None,
        **kwargs,
    ):
        cfg = app_config_dict or {}
        question = self._extract_question(request_payload)

        if not question:
            yield {"context_str": "質問が取得できませんでした。",
                   "retriever_metadata": []}
            yield STOP_CODON
            return

        answer_parts = []
        metadata_list = []
        seen = set()

        try:
            async for kind, value in self._stream_bedrock(question, cfg):
                if kind == "text":
                    answer_parts.append(value)
                    yield value                      # ← 逐次ストリーミング
                elif kind == "citation":
                    self._collect_references(value, metadata_list, seen)
        except Exception:
            self.logger_obj.exception("Bedrock RetrieveAndGenerateStream に失敗しました")
            if not answer_parts:
                # まだ何も送っていない場合のみエラー文言を返す
                yield {"context_str": "検索中にエラーが発生しました。",
                       "retriever_metadata": []}
                yield STOP_CODON
                return

        # 最後に引用メタデータ
        yield {
            "context_str": "".join(answer_parts),
            "retriever_metadata": metadata_list,
        }
        yield STOP_CODON

    # ------------------------------------------------------------------
    @staticmethod
    def _extract_question(request_payload):
        """リクエストから質問文を取り出す (chat.prompt / prompt の両対応)."""
        if not isinstance(request_payload, dict):
            return ""
        chat = request_payload.get("chat")
        if isinstance(chat, dict) and chat.get("prompt"):
            return str(chat["prompt"]).strip()
        return str(request_payload.get("prompt") or "").strip()

    # ------------------------------------------------------------------
    async def _stream_bedrock(self, question, cfg):
        """
        同期イテレータである EventStream を別スレッドで回し、
        ("text", str) / ("citation", dict) を非同期に流す。
        """
        region = cfg.get("aws_region", "ap-northeast-1")
        kb_id = cfg.get("knowledge_base_id")
        model_arn = cfg.get("generation_model_arn")

        if not kb_id or not model_arn:
            raise ValueError(
                "app_config_dict に knowledge_base_id / "
                "generation_model_arn が設定されていません"
            )

        loop = asyncio.get_running_loop()
        q: asyncio.Queue = asyncio.Queue()
        _DONE = object()

        def worker():
            try:
                client = boto3.client("bedrock-agent-runtime", region_name=region)
                resp = client.retrieve_and_generate_stream(
                    input={"text": question},
                    retrieveAndGenerateConfiguration={
                        "type": "KNOWLEDGE_BASE",
                        "knowledgeBaseConfiguration": {
                            "knowledgeBaseId": kb_id,
                            "modelArn": model_arn,
                            "retrievalConfiguration": {
                                "vectorSearchConfiguration": {
                                    "numberOfResults": cfg.get(
                                        "num_results", NUM_RESULTS
                                    ),
                                }
                            },
                        },
                    },
                )
                for event in resp["stream"]:
                    loop.call_soon_threadsafe(q.put_nowait, ("event", event))
            except Exception as exc:  # noqa: BLE001
                loop.call_soon_threadsafe(q.put_nowait, ("error", exc))
            finally:
                loop.call_soon_threadsafe(q.put_nowait, ("done", _DONE))

        threading.Thread(target=worker, daemon=True).start()

        while True:
            kind, payload = await q.get()

            if kind == "done":
                return
            if kind == "error":
                raise payload

            event = payload

            # テキストチャンク
            output = event.get("output")
            if isinstance(output, dict) and output.get("text"):
                yield "text", output["text"]
                continue

            # 引用情報
            citation = event.get("citation")
            if citation:
                # {"citation": {"citation": {...}}} / {"citation": {...}} 両対応
                inner = citation.get("citation") if isinstance(citation, dict) else None
                yield "citation", (inner if isinstance(inner, dict) else citation)
                continue

            # 例外系イベント
            for key in (
                "internalServerException",
                "validationException",
                "resourceNotFoundException",
                "accessDeniedException",
                "throttlingException",
                "conflictException",
                "dependencyFailedException",
                "badGatewayException",
            ):
                if key in event:
                    raise RuntimeError(f"{key}: {event[key]}")

    # ------------------------------------------------------------------
    @staticmethod
    def _collect_references(citation, metadata_list, seen):
        """citation イベントから retriever_metadata を積み上げる (重複除去)."""
        for ref in (citation or {}).get("retrievedReferences", []) or []:
            url = (ref.get("metadata") or {}).get(_SOURCE_URI_KEY, "")
            content = (ref.get("content") or {}).get("text", "")
            key = (url, content)
            if key in seen:
                continue
            seen.add(key)
            metadata_list.append({
                "filename": PurePosixPath(url).name if url else "",
                "url": url,
                "page_content": content,
            })
