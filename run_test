async def main():
    ce = CustomEntryPoint(domain_dict={}, logger_obj=L())

    payload = {
        "client_request_id": "t-001",
        "prompt": "勤怠管理について教えてください",
    }
    cfg = {
        "aws_region": "ap-northeast-1",
